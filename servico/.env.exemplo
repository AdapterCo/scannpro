# Copie para /etc/scannpro/servico.env na VPS e ajuste. Não coloque tokens do Mercado Pago aqui:
# cada cliente informa o próprio token no painel (fica em segredos/{uid} no Firestore).

# Chave da conta de serviço do Firebase Admin SDK (arquivo só na VPS, chmod 600, fora de qualquer repositório)
FIREBASE_CHAVE=/etc/scannpro/firebase-admin.json

# Endereço HTTPS público deste serviço, sem barra no final (o mesmo usado em -PpaymentApiUrl no APK)
URL_PUBLICA=https://pagamentos.seudominio.com.br

# Porta local (o Caddy/nginx publica em HTTPS e repassa para cá)
PORTA=8787

FIREBASE_PROJECT_ID=adapterdb-aba6f
FIREBASE_DATABASE_URL=https://adapterdb-aba6f-default-rtdb.firebaseio.com

# Validade do PIX em minutos (o Mercado Pago exige no mínimo 30; o serviço usa no mínimo 31)
PIX_VALIDADE_MIN=31
# E-mail de pagador exigido pela API (o cliente final do totem não informa e-mail)
PIX_EMAIL_PAGADOR=pagador@seudominio.com.br
PIX_DESCRICAO=Sessão ScannPro

# Intervalo da conciliação dos pagamentos pendentes (segundos)
CONCILIACAO_S=20
